# Local demo configuration for Docker Compose.
# Copy this file to .env and adjust if a port or database name is already taken.
# .env is untracked; never store real credentials here.

# Published host ports. Both bind to 127.0.0.1 only.
CRM_API_PORT=8000
PIPELINE_API_PORT=8001

# Local PostgreSQL bootstrap values for the demo database.
POSTGRES_DB=automotive
POSTGRES_USER=automotive
POSTGRES_PASSWORD=automotive-local-dev

# Pipeline extraction source. Inside Compose the CRM is reached by service name;
# CRM_PAGE_SIZE is bounded to 1-100 by the client and defaults to 3.
CRM_BASE_URL=http://crm-api:8000
CRM_PAGE_SIZE=3
